{
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "documentation/**",
      "docs/**",
      "*.zip",
      "*.docx",
      "*.xlsx",
      "accounts.json"
    ],
    "cleanUrls": false
  }
}
