# Database Configuration (Google Cloud SQL for PostgreSQL / PgBouncer)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=attendance_db
DB_MAX_CONNECTIONS=20
DB_SSL=false

# Google Cloud Platform & Firebase Configuration
GOOGLE_CLOUD_PROJECT=college-attendance-prod
FIREBASE_STORAGE_BUCKET=college-attendance-prod.appspot.com

# Transactional Email (Google Workspace SMTP Relay)
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@college.edu
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@college.edu
GOOGLE_WORKSPACE_DAILY_QUOTA=2000

# Application Configuration
NODE_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://college-attendance.web.app
# Cryptographically strong signing secret for session tokens (min 32 characters in production)
SESSION_SECRET=your_minimum_32_character_cryptographically_secure_session_secret
